QPushButton {
    background-color: #252832;
    color: #FFFFFF;
    border: 1px solid #383C49;
    border-radius: 6px;
    padding: 4px 14px;
    min-height: 26px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #323746;
    border: 1px solid #528BFF;
}

QPushButton:pressed {
    background-color: #1C4FC4;
    border: 1px solid #1C4FC4;
}

QPushButton:disabled {
    background-color: #1B1E26;
    color: #5B6072;
    border: 1px solid #262A35;
}

QPushButton#next_button {
    background-color: #2F6BFF;
    border: 1px solid #2F6BFF;
}

QPushButton#next_button:hover {
    background-color: #4A7FFF;
    border: 1px solid #4A7FFF;
}

QPushButton#next_button:pressed {
    background-color: #1C4FC4;
    border: 1px solid #1C4FC4;
}

QPushButton#next_button:disabled {
    background-color: #1B1E26;
    color: #5B6072;
    border: 1px solid #262A35;
}

QComboBox {
    background-color: #252832;
    color: #E4E6EB;
    border: 1px solid #383C49;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 26px;
}

QComboBox:hover {
    border: 1px solid #528BFF;
}

QComboBox:focus {
    border: 1px solid #528BFF;
}

QComboBox::drop-down {
    background-color: transparent;
    border: none;
    width: 26px;
}

QComboBox QAbstractItemView {
    background-color: #252832;
    color: #E4E6EB;
    border: 1px solid #383C49;
    selection-background-color: #315DAB;
    selection-color: #FFFFFF;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding-left: 6px;
}

QLineEdit {
    background-color: #252832;
    color: #E4E6EB;
    border: 1px solid #383C49;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 26px;
    selection-background-color: #315DAB;
}

QLineEdit:hover {
    border: 1px solid #528BFF;
}

QLineEdit:focus {
    border: 1px solid #528BFF;
    background-color: #1F222B;
}

QScrollBar:vertical {
    background-color: #181A20;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #444957;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #528BFF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}</string>
